{
  "name": "dsd-starters",
  "private": true,
  "type": "module",
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.js packages/puzzles/tests/*.test.js",
    "validate": "node scripts/question-codes.mjs --check && node scripts/validate.js && node scripts/coverage.js --check",
    "start": "npm run build && python3 -m http.server 8765 --bind 127.0.0.1 --directory live",
    "coverage": "node scripts/coverage.js",
    "search:index": "node scripts/search-index.mjs",
    "hints:audit": "node scripts/audit-hints.mjs",
    "codes:update": "node scripts/question-codes.mjs --update",
    "codes:check": "node scripts/question-codes.mjs --check",
    "dev": "vite",
    "predev": "node scripts/prepare-site.mjs",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "format": "prettier --write src vite.config.js jsconfig.json"
  },
  "dependencies": {
    "@maxgraph/core": "0.24.0",
    "fflate": "0.8.3",
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "bits-ui": "2.19.4",
    "daisyui": "5.7.47",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "imports": {
    "#domain/*": "./js/*",
    "#lib/*": "./src/lib/*"
  }
}
