{
  "name": "dsd-starters",
  "private": true,
  "type": "module",
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/question-codes.mjs --check && node scripts/validate.js && node scripts/coverage.js --check",
    "start": "npm run build && python3 -m http.server 8765 --bind 127.0.0.1 --directory live",
    "coverage": "node scripts/coverage.js",
    "hints:audit": "node scripts/audit-hints.mjs",
    "codes:update": "node scripts/question-codes.mjs --update",
    "codes:check": "node scripts/question-codes.mjs --check"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
